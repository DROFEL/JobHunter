# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://appuser:12345678@localhost:5432/appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=12345678
POSTGRES_DB=appdb

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
SCRAPER_CONCURRENCY=10

# ── OpenRouter AI ─────────────────────────────────────────────────────────────
OPEN_ROUTER_SK=your-openrouter-key
OPENROUTER_RPS=1.0

# ── LinkedIn scraper ──────────────────────────────────────────────────────────
LINKEDIN_ACCOUNTS=[{"email":"you@example.com","password":"your-password"}]

# ── Proxy ─────────────────────────────────────────────────────────────────────
PROXY=

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_WEB_API_URL=http://localhost:8000